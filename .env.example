# =============================================================================
# Protean AI Services — environment configuration
# =============================================================================

# ---- App ----
APP_ENV=development            # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
HOST=0.0.0.0
PORT=8000
WORKERS=1

# ---- Auth ----
# Shared secret expected in the Authorization header on every /api/* request.
# The Node orchestrator sends this as `Authorization: <key>` (NOT Bearer) to
# match the existing pattern used for Signzy connectors.
AI_API_KEY=change-me-shared-secret
IMAGE_AI_API_KEY=change-me-shared-secret

# ---- Image module ----
# Backend selector for the image module's predictors.
#   stub      — deterministic mock, no ML deps required (default for dev/CI)
#   deepface  — DeepFace-backed age/gender/detection (heavy, TensorFlow)
#   mediapipe — MediaPipe-backed face detect / crop (CPU, lightweight)
IMAGE_AI_BACKEND=deepface

# Optional override paths if a custom model weights bundle is mounted
IMAGE_MODEL_WEIGHTS_DIR=

# ---- Face detection quality gates ----
# Apply to deepface / mediapipe backends. When no detected face passes BOTH
# the confidence and size thresholds, age/gender are returned as null
# instead of being hallucinated from background pixels.
#   IMAGE_FACE_DETECTOR — yunet (recommended: OpenCV YuNet, upscaled + tiled,
#                         best on small Aadhaar/PAN/voter/DL/passport photos),
#                         retinaface, facenet (facenet-pytorch MTCNN),
#                         mtcnn, ssd, or opencv
#   IMAGE_MIN_FACE_CONFIDENCE — 0.0..1.0. 0.75 suits YuNet: its multi-scale
#     scan lifts real ID faces to ~0.88+ while stray boxes stay below ~0.70.
#   IMAGE_MIN_FACE_SIZE_PX — minimum width AND height in pixels. Kept low (24)
#     because inset ID-card photos are tiny; confidence is the real gate.
IMAGE_FACE_DETECTOR=yunet
IMAGE_MIN_FACE_CONFIDENCE=0.75
IMAGE_MIN_FACE_SIZE_PX=24

# ---- Performance ----
# Detection target edge (long edge, in pixels). Large phone photos are
# downscaled and small ID-card scans are UPSCALED to roughly this size before
# detection — a tiny inset photo is far easier to find once it is a few
# hundred pixels tall. Detection results are also cached per image so the
# endpoint calls (face-detect-crop / age-predict / gender-predict) share one
# detection pass.
IMAGE_MAX_DETECT_EDGE=1600

# ---- Face crop ----
# Padding added around each detected face box when producing the
# /ai/face-detect-crop images, as a fraction of the box width/height on each side.
# The raw detector box is tight and clips forehead / chin / ears — 0.4
# yields a natural head-and-shoulders crop. Raise for more surrounding
# context, lower (toward 0) for a tighter crop.
IMAGE_FACE_CROP_MARGIN=0.4
